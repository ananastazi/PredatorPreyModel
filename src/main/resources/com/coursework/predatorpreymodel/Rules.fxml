<AnchorPane prefHeight="800.0" prefWidth="1280.0" style="-fx-background-color: black;" stylesheets="@stylesheets/Rules.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coursework.predatorpreymodel.Rules">
   <children>
      <Text fill="WHITE" layoutX="64.0" layoutY="214.0" strokeType="OUTSIDE" strokeWidth="0.0" text="The Predator vs Prey game is a simulation model designed on a cellular automaton and applies the principles of Game of Life and Predators-preys models. The goal of the game is to observe the dynamics of the ecosystem, where predators and preys are in the lead roles." textAlignment="CENTER" wrappingWidth="1133.44140625">
         <font>
            <Font size="29.0" />
         </font>
      </Text>
      <Label layoutX="495.0" layoutY="65.0" text="Game rules" textFill="WHITE">
         <font>
            <Font size="56.0" />
         </font>
      </Label>
      <Text fill="WHITE" layoutX="73.0" layoutY="407.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Based on the level of energy both species look for a target, to satisfy their hunger and gain energy to live or to reproduce an offspring. If the individual's energy is lower than critical one or its lifespan is over, than the individual dies. " textAlignment="CENTER" wrappingWidth="1133.44140625">
         <font>
            <Font size="29.0" />
         </font>
      </Text>
      <Text fill="WHITE" layoutX="64.0" layoutY="591.0" strokeType="OUTSIDE" strokeWidth="0.0" text="The game continues until the ecosystem reaches the end of the predetermined life-cycles." textAlignment="CENTER" wrappingWidth="1133.44140625">
         <font>
            <Font size="29.0" />
         </font>
      </Text>
      <Button fx:id="backButton" layoutX="333.0" layoutY="685.0" mnemonicParsing="false" onAction="#Back" prefHeight="65.0" prefWidth="162.0" text="Back">
